# ==============================================================================
# Taneja Power Systems - Frontend (Client) Environment Configuration Template
# ==============================================================================
# Note: Variables exposed to the browser MUST start with VITE_ prefix.
# Never place database credentials, JWT secrets, or backend private keys here!
# ==============================================================================

# ==============================================================================
# Backend API Base URL
# ==============================================================================
# Development (local backend via Vite dev server proxy or direct port):
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Production (replace with your production backend domain):
# VITE_API_BASE_URL=https://api.tanejapower.com/api/v1

# ==============================================================================
# Application Branding
# ==============================================================================
VITE_APP_NAME="Taneja Power Management"
