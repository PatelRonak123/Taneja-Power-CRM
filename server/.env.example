# ==============================================================================
# Taneja Power Systems - Backend Environment Configuration Template
# ==============================================================================
# Usage:
#   Development: Copy to .env and adjust variables as needed.
#   Production:  Set these environment variables via your deployment platform (e.g. AWS, Render, Docker).
# ==============================================================================

# ==============================================================================
# 1. APPLICATION ENVIRONMENT (Required)
# ==============================================================================
# Expected values: development | production | test
# - development: Enables verbose errors, stack traces, local CORS, debug logging, local fallback OTP logging
# - production:  Enforces secure cookies, strict CORS, sanitized 500 error responses, blocked seed scripts
NODE_ENV=development

# Port on which the Express server listens (Optional, default: 5000)
PORT=5000

# Reverse Proxy Trust (Optional, recommended behind Nginx/Cloudflare/AWS ALB)
# In production, defaults to 1 if unset so secure cookies and client IPs function properly.
# Options: true, false, 1, or specific subnet/hops
# TRUST_PROXY=1

# ==============================================================================
# 2. DATABASE CONFIGURATION (Required - Sensitive)
# ==============================================================================
# PostgreSQL connection string
# Development:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taneja_power_db
# Production:
# DATABASE_URL=postgresql://user:password@production-db-host:5432/taneja_power_db?sslmode=require

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (Required - Sensitive)
# ==============================================================================
# Secret key used to sign and verify JSON Web Tokens (min 16 chars, 32+ recommended)
# In production, default development placeholder key is rejected at startup.
JWT_SECRET=super_secret_jwt_key_for_development_mode_min_32_chars

# Access and refresh token lifespans (Optional, defaults: 15m and 30d)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_EXPIRES_IN=15m

# ==============================================================================
# 4. CORS ORIGINS (Required)
# ==============================================================================
# Comma-separated list of allowed frontend origins
# Development:
CORS_ORIGIN=http://localhost:5173
# Production (replace with your actual production frontend domain(s)):
# CORS_ORIGIN=https://crm.tanejapower.com,https://admin.tanejapower.com

# ==============================================================================
# 5. COOKIE CONFIGURATION (Optional)
# ==============================================================================
# COOKIE_SECURE:
# - Unset / undefined: automatically false in development, true in production
# - Set explicitly to true or false to override
COOKIE_SECURE=false

# COOKIE_SAME_SITE: lax | strict | none (default: lax)
# Note: if frontend and backend are on different second-level domains with HTTPS, set to none with COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# COOKIE_DOMAIN: Optional custom domain scope for cookies (e.g., .tanejapower.com)
# COOKIE_DOMAIN=

# ==============================================================================
# 6. EXTERNAL INTEGRATIONS (Optional)
# ==============================================================================

# Resend Email Service (Optional: if unset, OTP is displayed in development console)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Taneja Power Systems <onboarding@resend.dev>

# Google Places & Geocoding API (Optional: used for address autocompletion)
# GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Service (@ronak_patel/whatsapp-kit)
# Set to false to disable WhatsApp initialization on server boot (default: true)
WHATSAPP_ENABLED=true

# ==============================================================================
# 7. BUSINESS LOCATION (Optional - Defaults to Vadodara HQ)
# ==============================================================================
OFFICE_LATITUDE=22.2965
OFFICE_LONGITUDE=73.1495
OFFICE_RADIUS_METERS=500

# ==============================================================================
# 8. PRODUCTION SAFEGUARDS (Optional)
# ==============================================================================
# Set to true ONLY if you deliberately intend to run `npm run db:seed` in production.
# By default, seeding demo data is blocked in production to protect real customer records.
ALLOW_PRODUCTION_SEED=false
