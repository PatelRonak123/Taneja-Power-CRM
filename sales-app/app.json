{
  "expo": {
    "name": "Taneja Power Sales",
    "slug": "taneja-power-sales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tanejapowersales",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tanejapower.salesapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Taneja Power requires location access to record employee check-in and check-out coordinates for daily attendance verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "com.tanejapower.salesapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Taneja Power requires location access to record employee check-in and check-out coordinates for daily attendance verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
