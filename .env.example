# ==============================================================================
# Taneja Power Systems - Root Environment Overview
# ==============================================================================
# This monorepo consists of:
#   1. server/     (Node.js / Express / TypeScript backend)
#   2. client/     (Vite / React 19 frontend web application)
#   3. sales-app/  (React Native / Expo mobile application)
#
# Environment configuration is managed independently per application directory:
#   - server/.env      (Copy from server/.env.example)
#   - client/.env      (Copy from client/.env.example)
#   - sales-app/.env   (Copy from sales-app/.env.example)
#
# ==============================================================================
# ENVIRONMENT SWITCHING QUICK REFERENCE
# ==============================================================================
#
# Development Mode:
#   In server/.env:
#     NODE_ENV=development
#     PORT=5000
#     DATABASE_URL=postgres://postgres:postgres@localhost:5432/taneja_power_db
#     JWT_SECRET=super_secret_jwt_key_for_development_mode_min_32_chars
#     CORS_ORIGIN=http://localhost:5173
#     COOKIE_SECURE=false
#   In client/.env:
#     VITE_API_BASE_URL=http://localhost:5000/api/v1
#
# Production Mode:
#   In server/.env (or runtime host environment variables):
#     NODE_ENV=production
#     PORT=5000
#     DATABASE_URL=postgresql://user:password@prod-db-host:5432/taneja_power_db?sslmode=require
#     JWT_SECRET=your_production_secure_random_key_min_32_chars
#     CORS_ORIGIN=https://crm.yourdomain.com
#     COOKIE_SECURE=true
#   In client/.env (set before `npm run build`):
#     VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
#
# See server/.env.example and client/.env.example for full options and documentation.
# ==============================================================================
